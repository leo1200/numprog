\begin{Verbatim}[commandchars=\\\{\}]
      \PYG{k+kn}{import} \PYG{n+nn}{math}
      \PYG{k+kn}{import} \PYG{n+nn}{numpy} \PYG{k}{as} \PYG{n+nn}{np}

      \PYG{k}{def} \PYG{n+nf}{exp\PYGZus{}series}\PYG{p}{(}\PYG{n}{x}\PYG{p}{,} \PYG{n}{n\PYGZus{}terms}\PYG{o}{=}\PYG{l+m+mi}{20}\PYG{p}{):}
\PYG{+w}{          }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{          Approximate exp(x) by a truncated series.}
\PYG{l+s+sd}{          \PYGZdq{}\PYGZdq{}\PYGZdq{}}
          \PYG{n}{result} \PYG{o}{=} \PYG{l+m+mf}{1.0}
          \PYG{n}{term} \PYG{o}{=} \PYG{l+m+mf}{1.0}

          \PYG{k}{for} \PYG{n}{k} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{n}{n\PYGZus{}terms}\PYG{p}{):}
              \PYG{n}{term} \PYG{o}{=} \PYG{n}{term} \PYG{o}{*} \PYG{n}{x} \PYG{o}{/} \PYG{n}{k}
              \PYG{n}{result} \PYG{o}{=} \PYG{n}{result} \PYG{o}{+} \PYG{n}{term}

          \PYG{k}{return} \PYG{n}{result}

      \PYG{k}{def} \PYG{n+nf}{integrate}\PYG{p}{(}\PYG{n}{func}\PYG{p}{,} \PYG{n}{a}\PYG{p}{,} \PYG{n}{b}\PYG{p}{,} \PYG{n}{n\PYGZus{}points}\PYG{o}{=}\PYG{l+m+mi}{10\PYGZus{}000}\PYG{p}{):}
\PYG{+w}{          }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{          Simple integral approximation, function}
\PYG{l+s+sd}{          evaluated at left interval edges.}
\PYG{l+s+sd}{          \PYGZdq{}\PYGZdq{}\PYGZdq{}}

          \PYG{n}{dx} \PYG{o}{=} \PYG{p}{(}\PYG{n}{b} \PYG{o}{\PYGZhy{}} \PYG{n}{a}\PYG{p}{)} \PYG{o}{/} \PYG{n}{n\PYGZus{}points}
          \PYG{n}{x} \PYG{o}{=} \PYG{n}{a} \PYG{o}{+} \PYG{n}{dx} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{arange}\PYG{p}{(}\PYG{n}{n\PYGZus{}points}\PYG{p}{)}

          \PYG{k}{return} \PYG{n}{np}\PYG{o}{.}\PYG{n}{sum}\PYG{p}{(}\PYG{n}{func}\PYG{p}{(}\PYG{n}{x}\PYG{p}{)} \PYG{o}{*} \PYG{n}{dx}\PYG{p}{)}

      \PYG{c+c1}{\PYGZsh{} approximate ∫\PYGZus{}0\PYGZca{}1 exp(\PYGZhy{}x\PYGZca{}2) dx}
      \PYG{n}{func} \PYG{o}{=} \PYG{k}{lambda} \PYG{n}{x}\PYG{p}{:} \PYG{n}{exp\PYGZus{}series}\PYG{p}{(}\PYG{o}{\PYGZhy{}}\PYG{n}{x} \PYG{o}{**} \PYG{l+m+mi}{2}\PYG{p}{)}
      \PYG{n}{a}\PYG{p}{,} \PYG{n}{b} \PYG{o}{=} \PYG{l+m+mf}{0.0}\PYG{p}{,} \PYG{l+m+mf}{1.0}
      \PYG{n}{approx} \PYG{o}{=} \PYG{n}{integrate}\PYG{p}{(}\PYG{n}{func}\PYG{p}{,} \PYG{n}{a}\PYG{p}{,} \PYG{n}{b}\PYG{p}{)}
