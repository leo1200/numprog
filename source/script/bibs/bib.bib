@article{
energetic_cosmic_ray,
author = {{Telescope Array Collaboration} and R. U. Abbasi  and M. G. Allen  and R. Arimura  and J. W. Belz  and D. R. Bergman  and S. A. Blake  and B. K. Shin  and I. J. Buckland  and B. G. Cheon  and T. Fujii  and K. Fujisue  and K. Fujita  and M. Fukushima  and G. D. Furlich  and Z. R. Gerber  and N. Globus  and K. Hibino  and R. Higuchi  and K. Honda  and D. Ikeda  and H. Ito  and A. Iwasaki  and S. Jeong  and H. M. Jeong  and C. H. Jui  and K. Kadota  and F. Kakimoto  and O. E. Kalashev  and K. Kasahara  and K. Kawata  and I. Kharuk  and E. Kido  and S. W. Kim  and H. B. Kim  and J. H. Kim  and J. H. Kim  and I. Komae  and Y. Kubota  and M. Y. Kuznetsov  and K. H. Lee  and B. K. Lubsandorzhiev  and J. P. Lundquist  and J. N. Matthews  and S. Nagataki  and T. Nakamura  and A. Nakazawa  and T. Nonaka  and S. Ogio  and M. Ono  and H. Oshima  and I. H. Park  and M. Potts  and S. Pshirkov  and J. R. Remington  and D. C. Rodriguez  and C. Rott  and G. I. Rubtsov  and D. Ryu  and H. Sagawa  and N. Sakaki  and T. Sako  and N. Sakurai  and H. Shin  and J. D. Smith  and P. Sokolsky  and B. T. Stokes  and T. S. Stroman  and K. Takahashi  and M. Takeda  and A. Taketa  and Y. Tameda  and S. Thomas  and G. B. Thomson  and P. G. Tinyakov  and I. Tkachev  and T. Tomida  and S. V. Troitsky  and Y. Tsunesada  and S. Udo  and F. R. Urban  and T. Wong  and K. Yamazaki  and Y. Yuma  and Y. V. Zhezher  and Z. Zundel },
title = {An extremely energetic cosmic ray observed by a surface detector array},
journal = {Science},
volume = {382},
number = {6673},
pages = {903-907},
year = {2023},
doi = {10.1126/science.abo5095},
URL = {https://www.science.org/doi/abs/10.1126/science.abo5095},
eprint = {https://www.science.org/doi/pdf/10.1126/science.abo5095},
abstract = {Cosmic rays are energetic charged particles from extraterrestrial sources, with the highest-energy events thought to come from extragalactic sources. Their arrival is infrequent, so detection requires instruments with large collecting areas. In this work, we report the detection of an extremely energetic particle recorded by the surface detector array of the Telescope Array experiment. We calculate the particle’s energy as 244±29\&nbsp;stat.\&nbsp;−76+51syst.\&nbsp;exa–electron\&nbsp;volts (~40 joules). Its arrival direction points back to a void in the large-scale structure of the Universe. Possible explanations include a large deflection by the foreground magnetic field, an unidentified source in the local extragalactic neighborhood, or an incomplete knowledge of particle physics. Cosmic rays are charged particles from space. At low energies, they mostly originate from the Sun, whereas at high energies, they are expected to be emitted by nearby active galaxies. The Telescope Array Collaboration now reports the detection of a cosmic ray event with an energy of about 240 exa–electron volts, more than a million times higher than that achieved by artificial particle accelerators. Such high-energy particles should experience only small deflections by foreground magnetic fields, but tracing back the arrival direction shows no obvious source galaxy. The authors suggest that the foreground magnetic fields might be stronger than expected, or there could be unknown particle physics at high energies. —Keith T. Smith Detection of a highly energetic cosmic ray is traced back to its arrival direction, but no source galaxy is evident.}}



