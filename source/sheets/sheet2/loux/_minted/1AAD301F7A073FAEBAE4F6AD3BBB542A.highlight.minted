          \PYG{n}{errors} \PYG{o}{=} \PYG{p}{[]}

          \PYG{k}{for} \PYG{n}{n} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{max\PYGZus{}iter} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{p}{):}
