      \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{jacobi\PYGZus{}solve}\PYG{p}{(}\PYG{n}{A}\PYG{p}{,} \PYG{n}{b}\PYG{p}{,} \PYG{n}{max\PYGZus{}iter}\PYG{p}{):}
