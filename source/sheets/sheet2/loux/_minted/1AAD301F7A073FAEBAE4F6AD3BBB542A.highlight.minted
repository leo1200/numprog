          \PYG{n}{errs} \PYG{o}{=} \PYG{n}{jacobi\PYGZus{}solve}\PYG{p}{(}\PYG{n}{A}\PYG{p}{,} \PYG{n}{b}\PYG{p}{,} \PYG{n}{N}\PYG{p}{)}
